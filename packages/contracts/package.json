{
  "name": "@ida/contracts",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    "./home-device": {
      "types": "./src/home-device.ts",
      "import": "./dist/home-device.js"
    },
    "./travel-notebook": {
      "types": "./src/travel-notebook.ts",
      "import": "./dist/travel-notebook.js"
    },
    "./open-meteo": {
      "types": "./src/open-meteo.ts",
      "import": "./dist/open-meteo.js"
    },
    "./weather": {
      "types": "./src/weather.ts",
      "import": "./dist/weather.js"
    },
    "./music-proposal": {
      "types": "./src/music-proposal.ts",
      "import": "./dist/music-proposal.js"
    },
    "./intelligence-audit": {
      "types": "./src/intelligence-audit.ts",
      "import": "./dist/intelligence-audit.js"
    },
    "./music-context": {
      "types": "./src/music-context.ts",
      "import": "./dist/music-context.js"
    },
    "./environment-brains": {
      "types": "./src/environment-brains.ts",
      "import": "./dist/environment-brains.js"
    },
    "./intelligence": {
      "types": "./src/intelligence.ts",
      "import": "./dist/intelligence.js"
    },
    ".": {
      "types": "./src/index.ts",
      "import": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./src/index.ts",
  "scripts": {
    "build": "tsc --project tsconfig.build.json",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "zod": "latest"
  }
}
