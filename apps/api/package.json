{
  "name": "@ida/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm --filter @ida/contracts build && pnpm --filter @ida/domain build && pnpm build && node dist/server.js",
    "start": "node dist/server.js",
    "build": "tsc --project tsconfig.build.json",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@electric-sql/pglite": "0.5.8",
    "@fastify/cors": "11.3.0",
    "@fastify/multipart": "^10.1.1",
    "@ida/contracts": "workspace:*",
    "@ida/domain": "workspace:*",
    "@modelcontextprotocol/client": "2.0.0",
    "@modelcontextprotocol/core": "2.0.0",
    "@modelcontextprotocol/server": "2.0.0",
    "@simplewebauthn/server": "14.0.1",
    "fastify": "5.12.1"
  },
  "devDependencies": {
    "@types/node": "26.4.0"
  }
}
