# Local development only. Do not put secrets in this file.
# Defaults work without this file: API on 127.0.0.1:8787 and Vite proxy on 5173.
IDA_API_HOST=127.0.0.1
IDA_API_PORT=8787

# LOCAL_DEMO is the initial default. LOCAL_LOCK enables the opt-in local-owner
# passphrase/cookie gateway. Once initialized, LOCAL_LOCK remains enforced
# across restarts even if this variable is removed or changed back.
# The initial access UI is available; browser acceptance and recovery are pending.
# It is still loopback-only and is not suitable for real personal data.
IDA_IDENTITY_MODE=LOCAL_DEMO

# Keep VITE_IDA_API_URL empty for this demo: access uses the same-origin Vite proxy.
# A separate-origin client is not supported by the local lock.
